<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:geonode="http://www.geonode.org/" xmlns:gml="http://www.opengis.net/gml" elementFormDefault="qualified" targetNamespace="http://www.geonode.org/">
  <xsd:import namespace="http://www.opengis.net/gml" schemaLocation="https://geonodeincra.serpro.gov.br/geoserver/schemas/gml/2.1.2/feature.xsd"/>
  <xsd:complexType name="sigef_geoType">
    <xsd:complexContent>
      <xsd:extension base="gml:AbstractFeatureType">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="0" name="status" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="rt" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="data_aprovacao" nillable="true" type="xsd:dateTime"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="data_submissao" nillable="true" type="xsd:dateTime"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="parcela_codigo" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="situacao_informada" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="registro_cns" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="registro_matricula" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="data_registro" nillable="true" type="xsd:date"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="transcricao" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="natureza" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="codigo_imovel" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="municipio_id" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="uf_id" nillable="true" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="area_hectares" nillable="true" type="xsd:double"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="nome_area" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="tipo_envio" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="geometry" nillable="true" type="gml:MultiPolygonPropertyType"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="sigef_geo" substitutionGroup="gml:_Feature" type="geonode:sigef_geoType"/>
</xsd:schema>
